generator client {
  provider = "prisma-client-js"
  // سازگاری با هاست اشتراکی (GLIBC 2.28 = EL8 / Debian 10 ⇒ OpenSSL 1.1.x):
  // در زمان generate، موتور کوئری «همه پلتفرم‌های این فهرست» در
  // node_modules/.prisma/client قرار می‌گیرد و در زمان اجرا، پلتفرم درست
  // به‌صورت خودکار انتخاب می‌شود. evidence: هاست cPanel با glibc 2.28 فقط با
  // موتورهای openssl-1.1.x کار می‌کند؛ نبودِ آن‌ها یعنی خطای Query engine
  // not found در اولین کوئری روی هاست.
  binaryTargets = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  mobile        String         @unique
  name          String
  company       String?
  password      String
  // نسخه SaaS: SUPER_ADMIN (سازنده — بدون مجموعه) | ORG_ADMIN (مدیر مجموعه)
  //             | SALES_MANAGER | VISITOR
  // قدیمی: ADMIN | USER — با اسکریپت بک‌فیل M3 به مقادیر جدید نگاشت می‌شود
  // (پیش‌فرض قدیمی "USER" عمداً حفظ شده تا ALTER بازساز جدول لازم نداشته باشد؛ کد همیشه نقش را صریح تعیین می‌کند)
  role          String         @default("USER")
  // مجموعه تعلق — بدون FK سطح دیتابیس (جلوگیری از بازسازی جدول در SQLite)؛
  // یکپارچگی در سطح برنامه: فقط از ctx نشست نوشته می‌شود و هیچ مسیر حذف Org وجود ندارد
  orgId         String?
  // قدیمی: kind = STAFF | PUBLIC (کاربر عمومی با ترِیال شخصی) — برای حساب‌های قدیمی حفظ شد
  // نوع حساب — STAFF: پرسنل تعریف‌شده توسط مدیر (معاف از قفل پایان ترِیال عمومی)
  //               PUBLIC: کاربر عمومیِ ثبت‌نام‌شده (دارای ترِیال شخصی ۲۴ ساعته)
  kind          String         @default("STAFF")
  // غیرفعال‌سازی مستقل حساب — بدون حذف اطلاعات؛ ورود و همه نشست‌ها مسدود می‌شود (سمت سرور)
  disabled      Boolean        @default(false)
  // ترِیال شخصی ۲۴ ساعته کاربر عمومی — فقط یک‌بار هنگام ثبت‌نام نوشته می‌شود (ضد آزمایش مجدد)
  trialUntil    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  grants        AccessGrant[]
  orders        Order[]
  payments      Payment[]
  sessions      AuthSession[]
  notifications Notification[]
  messageRecipients MessageRecipient[]
}

// نشست‌های سمت سرور — امکان ابطال توکن‌ها (خروج، ریست، حذف کاربر)
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique // SHA-256 of token — خود توکن هرگز ذخیره نمی‌شود
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}

// دسترسی زمان‌دار مدیر به کاربران — expiresAt = null یعنی اعتبار دائمی واقعی (بدون سقف)
model AccessGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections  String   @default("[]") // JSON array of section keys
  expiresAt DateTime?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id         String    @id @default(cuid())
  orgId      String? // مجموعه مالک — چندمجموعه‌ای (بدون FK — یکپارچگی سمت برنامه)
  name       String
  company    String?
  phone      String
  address    String?
  nationalId String?
  type       String    @default("STORE") // STORE | PHARMACY | SALON
  // آرشیو نرم (ممیزی v1.0.9): مشتری دارای سفارش/پرداخت هرگز سخت‌حذف نمی‌شود —
  // سوابق مالی باید بمانند؛ حذف مشتریِ دارای سابقه = آرشیو (قابل بازگردانی)
  archived   Boolean   @default(false)
  archivedAt DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  orders     Order[]
  payments   Payment[]

  @@index([archived])
  @@index([orgId, archived])
}

model ProductGroup {
  id        String    @id @default(cuid())
  orgId     String? // مجموعه مالک — چندمجموعه‌ای (بدون FK — یکپارچگی سمت برنامه)
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([orgId])
}

model Product {
  id            String       @id @default(cuid())
  orgId         String? // مجموعه مالک — چندمجموعه‌ای (بدون FK — یکپارچگی سمت برنامه)
  groupId       String
  group         ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  image         String? // data URL
  description   String?
  volume        String?
  offer         String? // مثلا 1+12
  pricePurchase Float        @default(0)
  priceStore    Float        @default(0)
  pricePharmacy Float        @default(0)
  priceSalon    Float        @default(0)
  discount      Float        @default(0) // درصد
  minOrder      Int          @default(1) // تعداد سفارش
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orderItems    OrderItem[]

  @@index([orgId])
}

model Order {
  id              String      @id @default(cuid())
  orgId           String? // مجموعه مالک — چندمجموعه‌ای (بدون FK — یکپارچگی سمت برنامه)
  // همگام‌سازی چنددستگاهی — ضد ثبت تکراری: شناسه یکتای سمت کلاینت (UUID)
  clientRef       String?     @unique
  deviceId        String? // شناسه دستگاه ثبت‌کننده (هدر X-Vizito-Device)
  createdOffline  Boolean     @default(false) // ثبت‌شده در حالت آفلاین
  syncedAt        DateTime? // لحظه تأیید سرور برای سفارش آفلاین
  needsReview     Boolean     @default(false) // تعارض قیمت با کاتالوگ فعلی — برای بررسی مدیر
  customerId      String
  // ممیزی v1.0.10 — Restrict: حذف مشتریِ دارای سفارش در سطح دیتابیس هم ممنوع است؛
  // حتی در رقابت هم‌زمان (حذف + ثبت سفارش) هیچ سفارشی آبشاری حذف نمی‌شود
  customer        Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUserId String?
  createdByUser   User?       @relation(fields: [createdByUserId], references: [id])
  title           String?
  priceType       String      @default("STORE") // STORE | PHARMACY | SALON | PURCHASE
  status          String      @default("FINAL") // FINAL | CANCELED
  totalAmount     Float       @default(0)
  settlementType  String? // نحوه تسویه قید‌شده روی فاکتور: CASH | CHECK | RECEIPT
  dueDays         Int? // سررسید تسویه (مثلا ۹۰ روزه) — روزشمار از تاریخ فاکتور
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payments        Payment[]

  @@index([orgId, createdAt])
}

// ثبت تسویه حساب مشتری — نقد / چک پای‌بار / رسید
model Payment {
  id              String    @id @default(cuid())
  orgId           String? // مجموعه مالک — چندمجموعه‌ای (بدون FK — یکپارچگی سمت برنامه)
  customerId      String
  // ممیزی v1.0.10 — Restrict: سوابق مالی (پرداخت‌ها) هرگز با حذف مشتری از بین نمی‌روند
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderId         String?
  order           Order?    @relation(fields: [orderId], references: [id])
  type            String // CASH | CHECK | RECEIPT
  amount          Float     @default(0)
  discountPercent Float     @default(0) // درصد تخفیف نقدی (مثلا ۸ برای ۸٪)
  discountAmount  Float     @default(0) // مبلغ بخشیده‌شده تخفیف — برای مانده حساب جزو پرداخت محاسبه می‌شود
  paidAt          DateTime? // تاریخ پرداخت (نقد/رسید)
  trackingNumber  String? // شماره پیگیری واریز (نقد)
  bankName        String? // نام بانک (چک)
  checkNumber     String? // شماره چک
  sayadiNumber    String? // شماره صیادی (چک)
  settleAt        DateTime? // تاریخ سررسید/تسویه چک
  note            String?
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([orgId, createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  quantity    Float    @default(1)
  volume      String?
  price       Float    @default(0)
  discount    Float    @default(0)
  offer       String? // آفر دستی خالی که کاربر پر می‌کند
  lineTotal   Float    @default(0)
  rowNumber   Int      @default(1)
  createdAt   DateTime @default(now())
}

// تنظیمات برنامه (لوگو، برند و ...)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// محدودکننده نرخ ماندگار (برخلاف نسخه درون‌حافظه‌ای، با ری‌استارت سرور پاک نمی‌شود)
// فقط برای مسیرهای حساس احراز هویت (ورود/ثبت‌نام) — چون در دیتابیس نوشته می‌شود
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// اعلان‌ها و یادداشت‌های مدیر برای کاربران (تغییرات کالا/گروه + پیام‌ها)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String    @default("SYSTEM") // CATALOG | NOTE | SYSTEM
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, createdAt])
}

// دفتر فروش لایسنس — مشخصات خریدار + مدت + کلید تحویلی (فقط سازنده برنامه)
model LicenseSale {
  id            String          @id @default(cuid())
  buyerName     String
  buyerMobile   String
  durationDays  Int
  durationLabel String
  key           String
  price         String?
  note          String?
  expiresAt     DateTime? // انقضای مؤثر — با شارژ مجدد تمدید می‌شود (بدون کلید جدید)؛ برای لایسنس دائمی همیشه null است
  // توقف حذف خودکار (مهلت ۳۰ روزه) توسط سازنده — فقط روی دفتر فروش سرور سازنده معنا دارد
  pauseDeletion Boolean   @default(false)
  createdAt     DateTime        @default(now())
  charges       LicenseCharge[]
}

// پیام‌های داخلی سازنده به کاربران (صندوق پیام) — حذف نرم برای حفظ تاریخچه گزارش‌پذیر
model Message {
  id         String    @id @default(cuid())
  senderId   String? // شناسه مالک ارسال‌کننده
  senderName String
  audience   String // ALL | ADMINS | STAFF | BUYERS | SALE_EXPIRING | SALE_EXPIRED | SALE_GRACE | USER
  title      String
  body       String?
  important  Boolean   @default(false)
  deletedAt  DateTime? // حذف نرم توسط مالک — از صندوق کاربران پنهان ولی در تاریخچه با نشان «حذف‌شده»
  createdAt  DateTime  @default(now())
  recipients MessageRecipient[]

  @@index([createdAt])
}

// گیرندگان پیام — ثبت وضعیت خوانده‌شدن؛ هر کاربر فقط ردیف‌های خودش را می‌بیند
model MessageRecipient {
  id        String    @id @default(cuid())
  messageId String
  message   Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

// تاریخچه شارژ/تمدید لایسنس خریدار — همان کلید، فقط تمدید انقضا
model LicenseCharge {
  id            String      @id @default(cuid())
  saleId        String
  sale          LicenseSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  addDays       Int
  note          String?
  createdByName String?
  createdAt     DateTime    @default(now())

  @@index([saleId, createdAt])
}

// نسخه‌های پشتیبان — فقط مدیر (فایل JSON خارج از پوشه عمومی + متادیتا در دیتابیس)
model Backup {
  id            String   @id @default(cuid())
  orgId         String? // null = بکاپ کامل سرور (سازنده/زمان‌بند)؛ مقدار = بکاپ مجموعه
  kind          String   @default("MANUAL") // MANUAL | DAILY | WEEKLY | MONTHLY
  fileName      String   @unique // نام فایل سمت سرور تولید می‌شود — هرگز از ورودی کاربر
  sizeBytes     Int      @default(0)
  counts        String   @default("{}") // JSON: تعداد رکوردها هنگام تهیه نسخه
  createdBy     String? // فقط برای نسخه‌های دستی — شناسه مدیر
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
}

// ══════════ چندمجموعه‌ای (SaaS v2.0) — جداول جدید ══════════

// مجموعه (Tenancy) — هر ثبت‌نام آزاد = یک مجموعه مستقل با تریال ۲۴ساعته سمت سرور
model Org {
  id            String    @id @default(cuid())
  name          String
  logo          String? // data URL — فاز تنظیمات مجموعه
  inviteCode    String? // کد دعوت اختصاصی مجموعه — فاز تنظیمات مجموعه
  status        String    @default("ACTIVE") // ACTIVE | SUSPENDED (تعلیق توسط سازنده)
  suspendedAt   DateTime?
  // تریال ۲۴ساعته — فقط سمت سرور و فقط یک‌بار نوشته می‌شود (ضد تمدید)
  trialStartsAt DateTime?
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  license        License?
  licenseEvents  LicenseEvent[]
  supportThreads SupportThread[]
  devices        Device[]
}

// لایسنس مستقل هر مجموعه — مدت‌های ۳۰/۹۰/۱۸۰/۳۶۵ روز + دائمی + تعلیق/فعال‌سازی مجدد
model License {
  id             String    @id @default(cuid())
  orgId          String    @unique
  org            Org       @relation(fields: [orgId], references: [id], onDelete: Restrict)
  plan           String    @default("D30") // D30 | D90 | D180 | D365 | PERM
  startsAt       DateTime  @default(now())
  expiresAt      DateTime? // null فقط برای PERM (دائمی)
  status         String    @default("ACTIVE") // ACTIVE | SUSPENDED
  source         String    @default("KEY") // KEY (کلید امضاشده) | ADMIN (صدور مستقیم سازنده) | MIGRATION
  currentKeyHash String? // SHA-256 کلید فعال — ضد استفاده مجدد همان کلید برای مجموعه دیگر
  note           String?
  maxUsers       Int? // آماده‌سازی آینده — اجرا نمی‌شود (طبق سند تا تأیید کارفرما)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  events         LicenseEvent[]
}

// تاریخچه صدور/فعال‌سازی/تمدید/تعلیق لایسنس — سوابق قابل نمایش برای سازنده
model LicenseEvent {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  license   License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  licenseId String?
  type      String // ISSUE | ACTIVATE | EXTEND | SUSPEND | RESUME | MIGRATION
  plan      String?
  days      Int? // برای EXTEND
  actorName String?
  note      String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// پشتیبانی داخلی — رشته پیام مجموعه با سازنده (دومسیره، وضعیت‌دار)
model SupportThread {
  id              String   @id @default(cuid())
  orgId           String
  org             Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  subjectType     String   @default("GENERAL") // GENERAL | BUY_LICENSE | RENEW
  status          String   @default("OPEN") // OPEN | ANSWERED | CLOSED
  unreadForOrg    Boolean  @default(false)
  unreadForVendor Boolean  @default(true)
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  messages        SupportMessage[]

  @@index([orgId, lastMessageAt])
  @@index([unreadForVendor, lastMessageAt])
}

// پیام پشتیبانی — clientRef برای ارسال آفلاین ضدرکورد تکراری
model SupportMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderSide String // ORG | VENDOR
  senderName String
  body       String
  clientRef  String?
  createdAt  DateTime      @default(now())

  @@unique([threadId, clientRef])
}

// هویت دستگاه‌های مجموعه (هر دستگاه UUID محلی خودش را می‌فرستد)
model Device {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deviceKey  String   @unique // UUID سمت کلاینت
  label      String?
  userId     String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// لاگ دسترسی مدیر کل به داده مجموعه‌ها — حسابرسی الزام بخش پنجم سند
model AdminAccessLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String?
  orgId     String? // مجموعه مورد مشاهده
  action    String // VIEW_ORG | VIEW_USERS | VIEW_ORDERS | ISSUE_LICENSE | ...
  detail    String? // JSON بدون داده حساس
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([actorId, createdAt])
}
