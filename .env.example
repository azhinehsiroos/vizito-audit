# =============================================================================
# ویزیتو — نمونه متغیرهای محیطی (VIZITO — Environment Variables Sample)
# -----------------------------------------------------------------------------
# این فایل فقط «نام متغیرها و توضیح» است — هیچ مقدار واقعی/امنیتی داخل آن نگذارید.
# روی هاست: مقادیر را در cPanel → Setup Node.js App → Environment variables وارد کنید
# (یا در فایل .env کنار پروژه — متغیرهای پنل همیشه اولویت دارند).
#
# راهنمای کامل نصب: docs/DEPLOY-CPANEL-FA.md
# =============================================================================

# -----------------------------------------------------------------------------
# ۱) دیتابیس — الزامی (هم در توسعه هم Production)
# -----------------------------------------------------------------------------
# فایل SQLite برنامه. روی سرور «مسیر مطلق» و «بیرون از public_html» بگذارید
# تا هم با هر Deploy جایگزین نشود و هم از وب قابل دانلود نباشد.
# پوشه‌اش باید از قبل قابل نوشتن باشد (اسکریپت راه‌اندازی خودش می‌سازد و تست می‌کند).
# اگر تنظیم نشود: برنامه بالا نمی‌آید (server.cjs با پیام واضح متوقف می‌شود).
#
# مثال cPanel (به‌جای USERNAME نام کاربری هاست):
DATABASE_URL=file:/home/USERNAME/vizito_data/vizito.db

# -----------------------------------------------------------------------------
# ۲) داده‌های ماندگار — به‌شدت توصیه‌شده در Production
# -----------------------------------------------------------------------------
# ریشه پوشه داده‌های ماندگار؛ فایل‌های پشتیبان در <VIZITO_DATA_DIR>/backups ذخیره می‌شوند.
# باید بیرون از پوشه عمومی سایت و بیرون از پوشه خود برنامه باشد.
# اگر تنظیم نشود: پشتیبان‌ها در <پوشه برنامه>/db/backups ذخیره می‌شوند
# (روی cPanel کار می‌کند ولی هنگام آپلود نسخه جدید ممکن است حذف شود — توصیه نمی‌شود).
# مثال:
VIZITO_DATA_DIR=/home/USERNAME/vizito_data

# -----------------------------------------------------------------------------
# ۳) راه‌اندازی اولیه — فقط برای نصب تازه
# -----------------------------------------------------------------------------
# SETUP_TOKEN: «کد راه‌اندازی اولیه» برای ساخت اولین مدیر از رابط کاربری.
#   روی نصب تازه الزامی است؛ اولین ثبت‌نام فقط با این کد مدیر می‌شود.
#   مقدار تصادفی قوی بگذارید (مثلاً خروجی: openssl rand -hex 24).
#   این کد فقط در همین env نگه داشته می‌شود — هرگز در کد/لاگ/README مقدارش را ننویسید.
#   پس از اولین ثبت‌نام، مسیر «اولین مدیر» برای همیشه بسته می‌شود و این کد بی‌اثر است؛
#   می‌توانید آن را از env حذف کنید (حذفش روی نصب فعال هیچ تاثیری ندارد).
#   اگر روی نصب تازه تنظیم نباشد: اولین ثبت‌نام رد می‌شود (403) — نصب قابل راه‌اندازی نیست.
SETUP_TOKEN=

# OWNER_MOBILES: شماره‌های موبایل «سازنده برنامه» با کاما (اختیاری).
#   این شماره‌ها پس از ثبت‌نام، دسترسی همیشگی بدون لایسنس دارند.
#   هیچ شماره‌ای داخل سورس نوشته نشده — فقط از همین متغیر خوانده می‌شود.
#   اگر خالی باشد: هیچ حساب سازنده‌ای وجود ندارد (رفتار عادی برای نصب مشتری).
# مثال: OWNER_MOBILES=0917xxxxxxx,0918yyyyyyy
OWNER_MOBILES=

# OWNER_SETUP_KEY: «کلید راه‌اندازی سازنده» — ثبت‌نام با شماره‌های OWNER_MOBILES
#   فقط با این کلید ممکن است (ضد سوءاستفاده). اگر OWNER_MOBILES خالی است، لازم نیست.
#   اگر این کلید تنظیم نباشد، ثبت‌نام شماره‌های سازنده مطلقاً رد می‌شود (fail-closed).
#   ثبت‌نام مجدد مالک با کلید درست فقط «همان حساب موجود» را به ADMIN ارتقا می‌دهد
#   (رمز عوض و نشست‌ها باطل می‌شود) — هرگز حساب مالک دوم نمی‌سازد.
#   مقدار تصادفی قوی بگذارید؛ هرگز داخل سورس یا لاگ ننویسید.
OWNER_SETUP_KEY=

# -----------------------------------------------------------------------------
# ۴) پشتیبان‌گیری — الزامی برای قابلیت پشتیبان (دستی و خودکار)
# -----------------------------------------------------------------------------
# کلید رمزنگاری فایل‌های پشتیبان (AES-256-GCM).
# حداقل ۳۲ کاراکتر تصادفی. مثال تولید: openssl rand -base64 48
# اگر نباشد یا کوتاه باشد: تهیه پشتیبان خطا می‌دهد (بقیه برنامه سالم کار می‌کند).
# هشدار: اگر این کلید را از دست بدهید، فایل‌های پشتیبان قبلی قابل بازگشایی نیستند.
BACKUP_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# ۵) امنیت شبکه — اختیاری
# -----------------------------------------------------------------------------
# TRUSTED_PROXY_HOPS: تعداد پروکسی‌های معتبر جلوی برنامه برای استخراج IP واقعی
#   از هدر x-forwarded-for (محدودسازی نرخ ورود/ثبت‌نام به این IP وابسته است).
#   روی cPanel (Passenger جلوی برنامه است): 1  — پیش‌فرض هم 1 است.
#   اگر CDN/فایروال دیگری هم جلوی هاست باشد، تعداد لایه‌ها را بگذارید.
#   ⚠️ اگر برنامه «مستقیم و بدون پروکسی» اجرا شود، هدر XFF توسط کلاینت قابل جعل است
#   و مبنای IP قابل اعتماد نیست — این محصول برای اجرای پشت Passenger (cPanel) طراحی شده.
# اگر اشتباه تنظیم شود: IP مهاجم ممکن است اشتباه تشخیص داده شود (محدودسازی نرخ ضعیف‌تر).
TRUSTED_PROXY_HOPS=1

# VIZITO_ALLOWED_ORIGINS: مبدأهای (Origin) مجاز اضافی برای گیت ضد CSRF — اختیاری.
#   معمولاً لازم نیست: درخواست خودِ برنامه همیشه Origin == دامنه خود سرور است.
#   فقط اگر برنامه پشت پروکسی/پنل خاصی «در iframe» باز می‌شود و Host با Origin
#   تفاوت دارد، مبدأ آن پنل را اینجا بگذارید (با کاما جدا).
#   wildcard پسوندی هم پشتیبانی می‌شود: *.example.com یا .example.com
#   یعنی هر زیردامنه example.com مجاز است.
# مثال: VIZITO_ALLOWED_ORIGINS=https://panel.example.com,*.myproxy.ir
VIZITO_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# ۶) لایسنس — معمولاً نیازی به تنظیم ندارید
# -----------------------------------------------------------------------------
# LICENSE_PUBLIC_KEY_PEM: فقط برای «چرخش کلید عمومی امضای لایسنس» — اختیاری.
#   اگر خالی باشد: کلید عمومیِ داخل برنامه استفاده می‌شود (رفتار عادی نصب مشتری).
LICENSE_PUBLIC_KEY_PEM=

# LICENSE_PRIVATE_KEY_PEM: کلید خصوصی امضای لایسنس — «فقط» روی سرور سازنده.
#   روی سرورهای مشتری هرگز تنظیم نکنید؛ اگر باشد دکمه صدور کلید از پنل فعال می‌شود.
#   روش رسمی صدور کلید: اسکریپت npm run license:gen روی سیستم سازنده
#   (کلید خصوصی در keys/license-private.pem — هرگز در گیت/ZIP/سرور مشتری نیست).
LICENSE_PRIVATE_KEY_PEM=

# -----------------------------------------------------------------------------
# ۷) پورت — روی cPanel دست نزنید
# -----------------------------------------------------------------------------
# PORT و HOSTNAME را cPanel (Passenger) خودش تنظیم می‌کند؛ به‌صورت دستی مقدار ندهید.
# در اجرای محلی/آزمایشی می‌توانید PORT=3100 و غیره بگذارید.
